# Django
SECRET_KEY=generate-a-long-random-string-here
# Leave DEBUG=True only while testing locally
DEBUG=False
# Comma-separated hosts you serve the app on
ALLOWED_HOSTS=localhost,127.0.0.1
# If behind a reverse proxy, add your e.g. photos.example.com here too
CSRF_TRUSTED_HOSTS=

# Port the container publishes on
PORT=8000

# Database password used by docker compose (both app and Postgres)
DB_PASSWORD=change-this-password

# Server owner account — created on first boot only
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Optional tuning
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
